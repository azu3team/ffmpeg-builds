#!/bin/bash
set -euo pipefail

# Independent engine SDK build. The existing 8.0 CLI build stays unchanged.
export MACOSX_DEPLOYMENT_TARGET=12.0
FFMPEG_TAG=n8.1.2
VPX_TAG=v1.15.2

die() { echo "ERROR: $*" >&2; exit 1; }

require_tools() {
  local tool
  for tool in "$@"; do
    command -v "$tool" >/dev/null || die "Missing build tool: $tool"
  done
}

build_sdk() {
  [[ $(uname -s) == Darwin && $(uname -m) == arm64 ]] || die "Requires macOS arm64"
  require_tools clang make perl pkg-config curl tar xcrun
  [[ ! -e "$root" ]] || die "Build root already exists; choose a fresh directory: $root"
  mkdir -p "$root/sources" "$root/build/vpx" "$root/build/ffmpeg" "$root/sdk/licenses"
  local jobs=${NUMJOBS:-$(sysctl -n hw.logicalcpu)}
  [[ $jobs =~ ^[1-9][0-9]*$ ]] || die "NUMJOBS must be a positive integer"
  local deps="$root/deps" sdk="$root/sdk" sources="$root/sources"
  local sysroot
  sysroot=$(xcrun --sdk macosx --show-sdk-path)
  export CC=clang CXX=clang++
  export CFLAGS="-arch arm64 -mmacosx-version-min=$MACOSX_DEPLOYMENT_TARGET -isysroot $sysroot"
  export CXXFLAGS="$CFLAGS" LDFLAGS="$CFLAGS"
  # Only the private static libvpx and Apple SDK libraries may be discovered.
  unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH LIBRARY_PATH PKG_CONFIG_PATH
  export PKG_CONFIG_LIBDIR="$deps/lib/pkgconfig"

  curl -fL "https://github.com/webmproject/libvpx/archive/refs/tags/$VPX_TAG.tar.gz" -o "$sources/libvpx.tar.gz"
  curl -fL "https://github.com/FFmpeg/FFmpeg/archive/refs/tags/$FFMPEG_TAG.tar.gz" -o "$sources/ffmpeg.tar.gz"
  mkdir "$sources/libvpx" "$sources/ffmpeg"
  tar xzf "$sources/libvpx.tar.gz" -C "$sources/libvpx" --strip-components=1
  tar xzf "$sources/ffmpeg.tar.gz" -C "$sources/ffmpeg" --strip-components=1

  (
    cd "$root/build/vpx"
    # v1.15.2 supports Darwin 24; unversioned darwin selects the iOS toolchain.
    "$sources/libvpx/configure" --target=arm64-darwin24-gcc --prefix="$deps" \
      --enable-pic --enable-static --disable-shared --disable-examples \
      --disable-tools --disable-docs --disable-unit-tests \
      --disable-vp8-encoder --disable-vp9-encoder --enable-vp9-highbitdepth
    make -j "$jobs"
    make install
  )

  local options=(
    --prefix=/ --install-name-dir=@rpath
    --arch=arm64 --target-os=darwin --cc=clang --cxx=clang++
    "--sysroot=$sysroot" "--extra-cflags=$CFLAGS" "--extra-ldflags=$LDFLAGS"
    --enable-shared --disable-static --enable-pic
    --disable-autodetect --enable-libvpx --enable-zlib --enable-videotoolbox
    --enable-pthreads --disable-programs --disable-doc --disable-debug
    --disable-avdevice --disable-avfilter --disable-network
    --disable-encoders --disable-muxers --pkg-config-flags=--static
  )
  (
    cd "$root/build/ffmpeg"
    "$sources/ffmpeg/configure" "${options[@]}"
    make -j "$jobs"
    make install DESTDIR="$sdk"
  )

  # Ship only the public headers, shared libraries/symlinks and license/config texts.
  # pkg-config files contain the private libvpx build prefix and are not SDK inputs.
  find "$sdk/lib" -type f ! -name '*.dylib' -delete
  rmdir "$sdk/lib/pkgconfig"
  cp "$sources/ffmpeg/COPYING.LGPLv2.1" "$sdk/licenses/FFmpeg-LGPL-2.1.txt"
  cp "$sources/ffmpeg/LICENSE.md" "$sdk/licenses/FFmpeg-LICENSE.md"
  cp "$sources/libvpx/LICENSE" "$sdk/licenses/libvpx-LICENSE.txt"
  cp "$sources/libvpx/PATENTS" "$sdk/licenses/libvpx-PATENTS.txt"
  {
    echo "FFmpeg $FFMPEG_TAG; static libvpx $VPX_TAG; macOS arm64 >= $MACOSX_DEPLOYMENT_TARGET"
    echo "Sources: https://github.com/FFmpeg/FFmpeg/tree/$FFMPEG_TAG"
    echo "         https://github.com/webmproject/libvpx/tree/$VPX_TAG"
    printf './configure'
    printf ' %q' "${options[@]}"
    printf '\n'
  } > "$sdk/BUILD-CONFIG.txt"
  echo "SDK built: $sdk"
}

verify_sdk() {
  require_tools clang otool lipo
  local sdk="$root/sdk" check="$root/verification" dylib dep id name
  [[ -d "$sdk/lib" ]] || die "Build the SDK first"
  [[ ! -e "$check" ]] || die "Verification directory already exists: $check"
  mkdir -p "$check"
  if grep -Eq -- '--enable-(gpl|nonfree)([ =]|$)' "$sdk/BUILD-CONFIG.txt"; then
    die "GPL/nonfree flag in SDK configuration"
  fi
  for name in avformat avcodec avutil swscale swresample; do
    [[ -L "$sdk/lib/lib$name.dylib" ]] || die "Missing library symlink: $name"
    [[ -d "$sdk/include/lib$name" ]] || die "Missing headers: $name"
  done
  for dylib in "$sdk"/lib/*.dylib; do
    [[ -L "$dylib" ]] && continue
    [[ $(lipo -archs "$dylib") == arm64 ]] || die "Non-arm64 library: $dylib"
    otool -D "$dylib"
    id=$(otool -D "$dylib" | sed -n '2p' | xargs)
    [[ $id == @rpath/* && -e "$sdk/lib/${id#@rpath/}" ]] || die "Invalid install name: $id"
    otool -L "$dylib"
    while IFS= read -r dep; do
      case "$dep" in
        /usr/lib/*|/System/Library/*) ;;
        @rpath/*) [[ -e "$sdk/lib/${dep#@rpath/}" ]] || die "Missing SDK dependency: $dep" ;;
        *) die "External dependency in $dylib: $dep" ;;
      esac
    done < <(otool -L "$dylib" | awk 'NR > 1 {print $1}')
  done

  # Relocate before linking/running; no DYLD_LIBRARY_PATH or build-tree rpath.
  cp -R "$sdk" "$check/sdk"
  cat > "$check/check.c" <<'C'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <libavcodec/avcodec.h>
#include <libavformat/avformat.h>
#include <libavutil/hwcontext.h>
#include <libavutil/pixdesc.h>
#include <libswscale/swscale.h>
#include <libswresample/swresample.h>

static void require(int ok, const char *message)
{
    if (!ok) { fprintf(stderr, "ERROR: %s\n", message); exit(1); }
}

static void check_alpha(const AVFrame *frame)
{
    require(frame->format == AV_PIX_FMT_YUVA420P, "decoded frame is not yuva420p");
    int transparent = 0;
    for (int y = 0; y < frame->height; ++y)
        for (int x = 0; x < frame->width; ++x)
            transparent |= frame->data[3][y * frame->linesize[3] + x] != 255;
    require(transparent, "decoded alpha plane is entirely opaque");
    printf("VP9 alpha: %s, %dx%d, non-opaque pixels present\n",
           av_get_pix_fmt_name(frame->format), frame->width, frame->height);
}

int main(int argc, char **argv)
{
    require(argc == 2, "expected generated VP9 WebM path");
    printf("configuration: %s\nlicense: %s\n", avcodec_configuration(), avcodec_license());
    require(!strstr(avcodec_configuration(), "--enable-gpl") &&
            !strstr(avcodec_configuration(), "--enable-nonfree"), "GPL/nonfree library configuration");
    require(avformat_version() >> 16 == 62 && avcodec_version() >> 16 == 62 &&
            avutil_version() >> 16 == 60 && swscale_version() >> 16 == 9 &&
            swresample_version() >> 16 == 6, "FFmpeg 8.1 library ABI mismatch");
    const char *decoders[] = {"libvpx", "libvpx-vp9", "h264", "hevc", "prores", "qtrle", "png"};
    void *iter = NULL;
    const AVCodec *codec;
    while ((codec = av_codec_iterate(&iter)))
        if (av_codec_is_decoder(codec)) printf("decoder: %s\n", codec->name);
    for (unsigned i = 0; i < sizeof(decoders) / sizeof(*decoders); ++i)
        require(avcodec_find_decoder_by_name(decoders[i]) != NULL, decoders[i]);
    iter = NULL;
    const AVInputFormat *input;
    while ((input = av_demuxer_iterate(&iter))) printf("demuxer: %s\n", input->name);
    require(av_find_input_format("mov") != NULL, "mov demuxer missing");
    require(av_find_input_format("matroska") != NULL, "matroska demuxer missing");
    const char *hw_codecs[] = {"h264", "hevc"};
    for (unsigned i = 0; i < sizeof(hw_codecs) / sizeof(*hw_codecs); ++i) {
        codec = avcodec_find_decoder_by_name(hw_codecs[i]);
        int found = 0;
        const AVCodecHWConfig *hw;
        for (int n = 0; (hw = avcodec_get_hw_config(codec, n)); ++n)
            found |= hw->device_type == AV_HWDEVICE_TYPE_VIDEOTOOLBOX;
        require(found, "VideoToolbox decoder configuration missing");
        printf("VideoToolbox configuration: %s\n", hw_codecs[i]);
    }

    AVFormatContext *format = NULL;
    require(avformat_open_input(&format, argv[1], NULL, NULL) >= 0, "WebM open failed");
    require(avformat_find_stream_info(format, NULL) >= 0, "stream info failed");
    int stream = av_find_best_stream(format, AVMEDIA_TYPE_VIDEO, -1, -1, NULL, 0);
    require(stream >= 0, "video stream missing");
    require(format->streams[stream]->codecpar->codec_id == AV_CODEC_ID_VP9, "fixture is not VP9");
    codec = avcodec_find_decoder_by_name("libvpx-vp9");
    AVCodecContext *context = avcodec_alloc_context3(codec);
    require(context != NULL, "codec allocation failed");
    require(avcodec_parameters_to_context(context, format->streams[stream]->codecpar) >= 0, "parameters failed");
    require(avcodec_open2(context, codec, NULL) >= 0, "libvpx-vp9 open failed");
    AVPacket *packet = av_packet_alloc();
    AVFrame *frame = av_frame_alloc();
    require(packet && frame, "packet/frame allocation failed");
    int decoded = 0;
    while (!decoded && av_read_frame(format, packet) >= 0) {
        if (packet->stream_index == stream) {
            require(avcodec_send_packet(context, packet) >= 0, "packet send failed");
            int result = avcodec_receive_frame(context, frame);
            require(result >= 0 || result == AVERROR(EAGAIN), "frame receive failed");
            decoded = result >= 0;
        }
        av_packet_unref(packet);
    }
    if (!decoded) {
        require(avcodec_send_packet(context, NULL) >= 0, "decoder flush failed");
        decoded = avcodec_receive_frame(context, frame) >= 0;
    }
    require(decoded, "no decoded frame");
    check_alpha(frame);
    av_frame_free(&frame);
    av_packet_free(&packet);
    avcodec_free_context(&context);
    avformat_close_input(&format);
    return 0;
}
C
  clang -arch arm64 -mmacosx-version-min="$MACOSX_DEPLOYMENT_TARGET" \
    -I"$check/sdk/include" "$check/check.c" -L"$check/sdk/lib" \
    -lavformat -lavcodec -lavutil -lswscale -lswresample \
    -Wl,-rpath,@executable_path/sdk/lib -o "$check/check"
  local ffmpeg=${1:-./workspace/bin/ffmpeg}
  [[ -x "$ffmpeg" ]] || die "Fixture generator not found: $ffmpeg"
  "$ffmpeg" -hide_banner -loglevel error -f lavfi \
    -i "color=c=red@0.25:s=64x64:r=1,format=yuva420p" -frames:v 1 \
    -c:v libvpx-vp9 -pix_fmt yuva420p -auto-alt-ref 0 -y "$check/alpha.webm"
  env -u DYLD_LIBRARY_PATH -u DYLD_FALLBACK_LIBRARY_PATH "$check/check" "$check/alpha.webm"
}

package_sdk() {
  local archive="$root/ffmpeg-lgpl-darwin-arm64-sdk.tar.gz"
  COPYFILE_DISABLE=1 tar czf "$archive" -C "$root/sdk" lib include licenses BUILD-CONFIG.txt
  tar tzf "$archive"
  du -h "$archive"
  shasum -a 256 "$archive"
}

[[ $# -ge 2 ]] || die "Usage: $0 {build|verify|package} BUILD_ROOT [FIXTURE_FFMPEG]"
action=$1
root=$2
[[ $root == /* ]] || root="$PWD/$root"
case "$action" in
  build) build_sdk ;;
  verify) verify_sdk "${3:-./workspace/bin/ffmpeg}" ;;
  package) package_sdk ;;
  *) die "Unknown action: $action" ;;
esac
